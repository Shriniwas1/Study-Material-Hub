PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=Cluster0
DB_NAME=study_hub

JWT_SECRET=your_secure_jwt_secret_key_change_in_production
JWT_EXPIRES=7d

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI & Embedding Providers
GEMINI_API_KEY=your_gemini_api_key
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
LLM_MODEL=gemini-1.5-flash

# Vector Search Config
VECTOR_INDEX_NAME=vector_index
MIN_RELEVANCE_SCORE=0.25

# Rate Limits
AUTH_RATE_LIMIT=10
API_RATE_LIMIT=200
UPLOAD_RATE_LIMIT=15
CHAT_RATE_LIMIT=20

# Resource Quotas
MAX_STUDY_SESSIONS=20
MAX_SESSION_DOCUMENTS=10
MAX_PDF_SIZE_MB=15
MAX_PAGES_PER_DOC=150
MAX_DAILY_AI_QUESTIONS=100
MAX_DAILY_QUIZZES=20
MAX_TOKEN_CONTEXT=4000
MAX_TOP_K=5
MAX_QUIZ_QUESTIONS=10
CHUNK_SIZE=800
CHUNK_OVERLAP=100

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
